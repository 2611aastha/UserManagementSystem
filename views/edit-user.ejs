<!DOCTYPE html>
<html>
<head>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        input{
    border-radius:12px !important;
    padding:10px;
}

body{
    background:#070713;
    color:white;
    font-family:'Segoe UI',sans-serif;
    min-height:100vh;
}

.card-theme{
    background:rgba(255,255,255,0.05);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:20px;
    backdrop-filter:blur(12px);
}

.btn-theme{
    background:#6c63ff;
    color:white;
    border:none;
    padding:10px 20px;
    border-radius:10px;
}

.btn-theme:hover{
    opacity:0.9;
}

</style>
    <title>Edit User</title>
</head>
<body>

    <div class="container">

<div class="card-theme p-4 mx-auto"
style="max-width:500px;margin-top:100px;">

<h1>Edit User</h1>

<form action="/edit/<%= user._id %>"
      method="POST"
      enctype="multipart/form-data">

        <img
    src="/uploads/<%= user.profilePicture %>"
    width="100"
    height="100"
    style="border-radius:50%;">

    <br><br>

    <input
        type="text"
        name="name"
        value="<%= user.name %>"
        required>

    <br><br>

    <input
        type="email"
        name="email"
        value="<%= user.email %>"
        required>

    <br><br>

    <input
        type="text"
        name="contact"
        value="<%= user.contact %>"
        required>

    <br><br>

        <input
    type="file"
    name="profilePicture">

    <br><br>

    <button type="submit" class="btn-theme">
        Update User
    </button>

</form>

</div>

</div>

</body>
</html>