<!DOCTYPE html>
<html>
<head>

<title>User Management System</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
    background:#070713;
    color:white;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.card-theme{
    background:rgba(255,255,255,0.05);
    padding:40px;
    border-radius:20px;
    text-align:center;
}

.btn-theme{
    background:#6c63ff;
    color:white;
    border:none;
    border-radius:10px;
    padding:10px 25px;
    margin:10px;
}

</style>

</head>

<body>

<div class="card-theme">

    <h1>User Management System</h1>

    <br>

    <a href="/login">
        <button class="btn-theme">
            Login
        </button>
    </a>

    <a href="/register">
        <button class="btn-theme">
            Register
        </button>
    </a>

</div>

</body>
</html>